otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ===== LOGS: tail trace-file.log and ship to Loki =====
local.file_match "trace_file_logs" {
  path_targets = [
    { __path__ = "/var/log/trace-file/trace-file.log" },
  ]
}

loki.source.file "trace_file" {
  targets    = local.file_match.trace_file_logs.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ===== METRICS: scrape the app's actuator/prometheus endpoint =====
prometheus.scrape "trace_file_app" {
  targets = [
    { __address__ = "host.docker.internal:8081" },
  ]
  metrics_path = "/trace-file/actuator/prometheus"
  forward_to   = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}