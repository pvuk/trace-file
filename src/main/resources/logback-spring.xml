<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ========================= -->
    <!-- Console Appender -->
    <!-- ========================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
	    <encoder>
	        <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} [trace_id=%X{trace_id:-},span_id=%X{span_id:-}] - %msg%n</pattern>
	    </encoder>
	</appender>
	
    <!-- ========================= -->
    <!-- Rolling File Appender -->
    <!-- ========================= -->
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
	    <file>logs/trace-file.log</file>
	    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
	        <fileNamePattern>logs/trace-file.%d{yyyy-MM-dd}.log</fileNamePattern>
	        <maxHistory>30</maxHistory>
	        <totalSizeCap>1GB</totalSizeCap>
	    </rollingPolicy>
	    <encoder>
	        <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} [trace_id=%X{trace_id:-},span_id=%X{span_id:-}] - %msg%n</pattern>
	    </encoder>
	</appender>

    <!-- ========================= -->
    <!-- Root Logger -->
    <!-- ========================= -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- ========================= -->
    <!-- Example Package Log Levels -->
    <!-- ========================= -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="com.trace.file" level="DEBUG"/>
</configuration>
